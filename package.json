{
    "name": "testcase-tracker",
    "description": "Checklist-based test case tracker with auto-save and PostgreSQL persistence",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "db:migrate": "npx prisma migrate dev --name init",
        "db:push": "npx prisma db push",
        "db:studio": "npx prisma studio"
    },
    "dependencies": {
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "postgres": "^3.4.9"
    },
    "devDependencies": {
        "prisma": "^7.8.0"
    }
}
